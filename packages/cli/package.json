{
  "name": "marinate-audit",
  "version": "0.1.2",
  "type": "module",
  "description": "Find retired, stale, and upgrade-breaking AI model configurations before they reach production. Local, zero-credential, all major providers.",
  "keywords": [
    "llm",
    "ai",
    "model",
    "deprecation",
    "lint",
    "audit",
    "anthropic",
    "openai",
    "gemini",
    "static-analysis"
  ],
  "homepage": "https://marinate.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinate-dev/marinate.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/marinate-dev/marinate/issues",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "marinate": "./dist/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle-data.mjs"
  },
  "dependencies": {
    "@marinate-audit/engine": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
