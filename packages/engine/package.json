{
  "name": "@marinate-audit/engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Marinate analysis engine — PURE: no filesystem, no network, no process access. Internal to the marinate-audit CLI.",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "license": "MIT"
}
