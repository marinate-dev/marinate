{
  "name": "marinate-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Marinate — finds retired, stale, and upgrade-breaking AI model configurations before they reach production.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
